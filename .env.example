# Copy to .env and fill in. Never commit .env.
# Azure access uses Entra sign-in (`az login`), so there are no API keys here.

# Local Postgres 17 + pgvector container
DATABASE_URL=postgresql+psycopg://immicite:immicite@localhost:5432/immicite

# Azure Foundry endpoint, e.g. https://<resource>.openai.azure.com
AZURE_OPENAI_ENDPOINT=
